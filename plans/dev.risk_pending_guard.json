      "au": 1
    }
  },
  "strategies": [
    {
      "name": "simple_strategy",
      "params": {},
      "symbols": ["au"],
      "priority": 1,
      "weight": 1.0
    }
  ],
  "runtime": {
    "mode": "simulated_v2",
    "ticks_live": 5,
    "ticks_sandbox": 0,
    "default_quantity": 1.0
