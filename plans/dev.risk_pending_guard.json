{
  "schema_version": 1,
  "env": "dev",
  "universe": {
    "symbols": ["au"]
  },
  "adapters": {
    "market_data": {
      "mode": "simulated_v2",
      "params": {
        "seed": 2701,
        "start_prices": {
          "au": 120.0
        },
        "start_volumes": {
          "au": 1000.0
        },
        "drift": 0.0,
        "vol": 0.0
      }
    },
    "broker": {
      "mode": "simulated",
      "params": {
        "fill_delay_ticks": 2,
        "partial_fill_ratio": 1.0,
