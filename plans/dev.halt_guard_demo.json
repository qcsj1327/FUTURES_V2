{
  "schema_version": 1,
  "env": "dev",
  "universe": { "symbols": ["au", "ag"] },
  "adapters": {
    "market_data": {
      "mode": "simulated_v2",
      "params": {
        "seed": 4102,
        "start_prices": { "au": 120.0, "ag": 121.0 },
        "start_volumes": { "au": 1000.0, "ag": 1100.0 },
        "drift": 0.0,
        "vol": 0.0
      }
    },
    "broker": {
      "mode": "simulated",
      "params": { "fill_delay_ticks": 0 }
    }
  },
  "execution": {
    "max_pending_ticks": 2,
    "max_rejects_in_window": 2,
    "halt_ticks": 2,
    "min_order_interval_ticks": 3
  },
  "risk": {
    "max_notional_by_symbol": { "ag": 1.0 },
    "max_position_qty_by_symbol": { "au": 10.0, "ag": 10.0 }
  },
  "strategies": [
    {
      "name": "simple_strategy",
      "params": {},
      "symbols": ["au", "ag"],
      "priority": 1,
      "weight": 1.0
    }
  ],
  "runtime": {
    "mode": "simulated_v2",
    "ticks_live": 5,
    "ticks_sandbox": 0,
    "default_quantity": 1.0
  },
  "promotion": {
    "min_events": 1,
    "min_success_rate_improvement": -1.0,
    "max_consecutive_failures": 99
  },
  "router": { "mode": "priority", "tie_breaker": "priority" }
}
