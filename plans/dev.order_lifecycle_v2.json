{
  "schema_version": 1,
  "env": "dev",
  "universe": { "symbols": ["au"] },
  "adapters": {
    "market_data": {
      "mode": "simulated_v2",
      "params": {
        "seed": 26,
        "start_prices": { "au": 120.0 },
        "start_volumes": { "au": 1000.0 },
        "drift": 0.0,
        "vol": 0.0
      }
    },
    "broker": {
      "mode": "simulated",
      "params": {
        "fill_delay_ticks": 1,
        "partial_fill_ratio": 0.25,
        "max_partial_steps": 99
      }
    }
  },
  "execution": {
    "max_pending_ticks": 3
  },
  "strategies": [
    {
      "name": "simple_strategy",
      "params": {},
      "symbols": ["au"],
      "priority": 1,
      "weight": 1.0
    }
  ],
  "runtime": {
    "ticks_live": 5,
    "ticks_sandbox": 0,
    "default_quantity": 1.0
  },
  "promotion": {
    "min_events": 1,
    "min_success_rate_improvement": -1.0,
    "max_consecutive_failures": 99
  },
  "router": { "mode": "priority", "tie_breaker": "priority" }
}
