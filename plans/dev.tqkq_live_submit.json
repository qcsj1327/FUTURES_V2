{
  "schema_version": 1,
  "env": "dev",
  "universe": {
    "symbols": ["au"]
  },
  "runtime": {
    "mode": "tqkq_live",
    "warmup_seconds": 8,
    "ticks_live": 3,
    "ticks_sandbox": 0,
    "default_quantity": 1.0
  },
  "adapters": {
    "market_data": {
      "params": {
        "tq_symbols": {
          "au": "SHFE.au2406"
        },
        "warmup_seconds": 8
      }
    },
    "broker": {
      "params": {
        "dry_run": false
