        "au": "SHFE.au2406"
      }
    }
  },
  "strategies": [
    {
      "name": "simple_strategy",
      "params": {},
      "symbols": ["au"],
      "priority": 1,
      "weight": 1.0
    }
  ],
  "promotion": {
    "min_events": 1,
    "min_success_rate_improvement": -1.0,
    "max_consecutive_failures": 99
  },
  "router": {
    "mode": "priority",
    "tie_breaker": "priority"
  }
