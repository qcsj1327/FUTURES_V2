{
  "schema_version": 1,
  "env": "dev",
  "universe": {
    "symbols": ["au"]
  },
  "runtime": {
    "mode": "tqkq_live",
    "warmup_seconds": 1,
    "ticks_live": 2,
    "ticks_sandbox": 0,
    "default_quantity": 1.0
  },
  "adapters": {
    "market_data": {
      "mode": "tqkq",
      "params": {
        "tq_symbols": {
          "au": "SHFE.au2406"
        },
        "warmup_seconds": 1,
        "fake_quotes": {
          "SHFE.au2406": {
            "price": 450.0,
            "volume": 1000.0,
            "datetime": "2026-05-04 10:00:00.000000",
            "price_tick": 0.2,
            "volume_multiple": 1000.0
          }
        }
      }
    },
    "broker": {
      "mode": "tqkq_live",
      "params": {
        "submit_mode": "dry_run"
      }
    }
  },
  "execution": {
    "max_pending_ticks": 2
  },
  "instruments": {
    "roll_policy": {
      "mode": "fixed_contract",
      "contracts": {
        "au": "SHFE.au2406"
      }
    }
  },
  "strategies": [
    {
      "name": "simple_strategy",
      "params": {},
      "symbols": ["au"],
      "priority": 1,
      "weight": 1.0
    }
  ],
  "promotion": {
    "min_events": 1,
    "min_success_rate_improvement": -1.0,
    "max_consecutive_failures": 99
  },
  "router": {
    "mode": "priority",
    "tie_breaker": "priority"
  }
}
